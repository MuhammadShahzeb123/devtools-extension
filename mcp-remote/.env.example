# ── Remote MCP server (run on the VPS) ────────────────────────────────────────
PORT=51882

# Path secret for the MCP endpoint. Claude.ai connector URL becomes:
#   https://mcp.yourdomain.com/mcp/<MCP_SECRET>
# Generate with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MCP_SECRET=change-me-mcp-secret

# Shared secret the laptop relay must present when connecting to /ws
RELAY_TOKEN=change-me-relay-token

# How long the server waits for the laptop before failing a tool call (ms)
JOB_TIMEOUT_MS=90000

# ── Laptop relay agent (relay-agent.js) ───────────────────────────────────────
# RELAY_URL is the public URL the laptop dials OUT to. For local testing:
#   RELAY_URL=ws://127.0.0.1:51882/ws
# For production over Cloudflare Tunnel:
#   RELAY_URL=wss://mcp.fumblemap.com/ws
RELAY_URL=wss://mcp.fumblemap.com/ws

# Bridge to control (default http://127.0.0.1:1232)
# CDP_BRIDGE_BASE=http://127.0.0.1:1232
